{
  "name": "game-ad-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @gas/server\" \"npm run dev -w @gas/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "studio": "remotion studio packages/compositions/src/entry.ts"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.535",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
